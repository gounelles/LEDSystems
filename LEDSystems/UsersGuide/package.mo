within LEDSystems;
package UsersGuide "Guide d'utilisation"
  extends Modelica.Icons.Information;

  annotation (Documentation(info="<html>
<p>Guide d'utilisation de la bibliothèque LEDSystems. Ordre de lecture conseillé :</p>
<ol>
<li><a href=\"modelica://LEDSystems.UsersGuide.Overview\">Overview</a> : ce que fait la
    bibliothèque, le modèle d'une LED, le choix d'un composant ;</li>
<li><a href=\"modelica://LEDSystems.Examples.Basics\">Examples.Basics</a> : les exemples de
    base, dans l'ordre ;</li>
<li><a href=\"modelica://LEDSystems.UsersGuide.Tutorial\">Tutorial</a> : paramétrer une
    nouvelle LED à partir de son datasheet, avec ou sans l'aide d'une IA ;</li>
<li><a href=\"modelica://LEDSystems.UsersGuide.Conventions\">Conventions</a> : unités, tracé paramétrique, signes,
    grandeurs d'une LED ou totales, résistances thermiques ;</li>
<li><a href=\"modelica://LEDSystems.UsersGuide.Validation\">Validation</a> : comparaison aux
    datasheets, limites connues du modèle.</li>
</ol>
<p>Voir aussi : <a href=\"modelica://LEDSystems.UsersGuide.ReleaseNotes\">ReleaseNotes</a>
(notes de version), <a href=\"modelica://LEDSystems.UsersGuide.References\">References</a>,
<a href=\"modelica://LEDSystems.UsersGuide.License\">License</a>,
<a href=\"modelica://LEDSystems.UsersGuide.Contact\">Contact</a>.</p>
</html>"));
end UsersGuide;
